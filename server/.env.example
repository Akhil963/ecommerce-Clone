# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/ecommerce
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecommerce?retryWrites=true&w=majority

# JWT Configuration
# amazon-clone-super-secret-jwt-key-for-development-only-change-in-prod
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters
JWT_EXPIRE=30d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Twilio Configuration (Phone OTP)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Email Service Configuration
# ===========================
# NOTE: Email autoretry is enabled - failed emails are queued and retried every 5 minutes
# All email operations are non-blocking (won't delay user responses)

# RECOMMENDED: Brevo SMTP (Free - 300 emails/day, most reliable)
# Setup Instructions:
# 1. Sign up: https://www.brevo.com
# 2. Go to Settings → SMTP & API
# 3. Create new SMTP key
# 4. Use credentials below:
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=xsmtpsib-your-brevo-api-key
EMAIL_FROM=Amazon Ecommerce <noreply@ecommerce.com>

# ALTERNATIVE: Gmail SMTP (Free - unlimited)
# Setup Instructions:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to App passwords (https://myaccount.google.com/apppasswords)
# 4. Select "Mail" and your device, click Generate
# 5. Copy the 16-character password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ALTERNATIVE: SendGrid SMTP (Free - 100 emails/day)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your-sendgrid-api-key


# Frontend URL (for CORS and email links)
CLIENT_URL=http://localhost:3000

# Optional: Cloudinary for image uploads
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Optional: Stripe for payments
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Optional: Razorpay for payments (India)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
